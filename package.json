{
  "name": "horadel-transport",
  "version": "1.0.0",
  "description": "HoraDel Transport Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'No build step required'",
    "vercel-build": "echo 'Vercel build complete'",
    "test": "node -e \"console.log('Tests not configured yet')\"",
    "artillery": "artillery run artillery-config.yml",
    "artillery:smoke": "artillery run artillery-smoke-test.yml",
    "artillery:stress": "artillery run artillery-stress-test.yml",
    "lint": "echo 'Linting not configured'",
    "validate": "node -e \"require('./config/supabase'); console.log('Configuration valid')\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
